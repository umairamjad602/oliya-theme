{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: transparent;
    position: relative;
  }

  .ai-banner-slider-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .ai-banner-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    touch-action: pan-y;
    gap: {{ block.settings.slide_gap }}px;
  }

  .ai-banner-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(100% - {{ block.settings.slide_gap }}px);
    width: calc(100% - {{ block.settings.slide_gap }}px);
    position: relative;
  }

  .ai-banner-slide-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-banner-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    cursor: pointer;
    text-decoration: none;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-banner-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider-container-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }

    .ai-banner-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }} class="ai-banner-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-slider-container-{{ ai_gen_id }}">
    <div class="ai-banner-slider-wrapper-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign desktop_image_key = 'banner_desktop_image_' | append: i
          assign mobile_image_key = 'banner_mobile_image_' | append: i
          assign url_key = 'banner_url_' | append: i
          assign enable_key = 'enable_banner_' | append: i
          assign desktop_image = block.settings[desktop_image_key]
          assign mobile_image = block.settings[mobile_image_key]
          assign banner_url = block.settings[url_key]
          assign banner_enabled = block.settings[enable_key]
        %}

        {% if banner_enabled %}
          <div class="ai-banner-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if banner_url != blank %}
              <a href="{{ banner_url }}" class="ai-banner-link-{{ ai_gen_id }}">
                {% if desktop_image %}
                  <img
                    src="{{ desktop_image | image_url: width: 2000 }}"
                    alt="{{ desktop_image.alt | escape }}"
                    loading="lazy"
                    width="{{ desktop_image.width }}"
                    height="{{ desktop_image.height }}"
                    class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-desktop-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-banner-placeholder-{{ ai_gen_id }} ai-banner-image-desktop-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                    <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                      Add banner {{ i }} desktop image
                    </div>
                  </div>
                {% endif %}

                {% if mobile_image %}
                  <img
                    src="{{ mobile_image | image_url: width: 1000 }}"
                    alt="{{ mobile_image.alt | escape }}"
                    loading="lazy"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                    class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}"
                  >
                {% elsif desktop_image %}
                  <img
                    src="{{ desktop_image | image_url: width: 1000 }}"
                    alt="{{ desktop_image.alt | escape }}"
                    loading="lazy"
                    width="{{ desktop_image.width }}"
                    height="{{ desktop_image.height }}"
                    class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-banner-placeholder-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                    <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                      Add banner {{ i }} mobile image
                    </div>
                  </div>
                {% endif %}
              </a>
            {% else %}
              {% if desktop_image %}
                <img
                  src="{{ desktop_image | image_url: width: 2000 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-desktop-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-banner-placeholder-{{ ai_gen_id }} ai-banner-image-desktop-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                    Add banner {{ i }} desktop image
                  </div>
                </div>
              {% endif %}

              {% if mobile_image %}
                <img
                  src="{{ mobile_image | image_url: width: 1000 }}"
                  alt="{{ mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ mobile_image.width }}"
                  height="{{ mobile_image.height }}"
                  class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}"
                >
              {% elsif desktop_image %}
                <img
                  src="{{ desktop_image | image_url: width: 1000 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-banner-image-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-banner-placeholder-{{ ai_gen_id }} ai-banner-image-mobile-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                    Add banner {{ i }} mobile image
                  </div>
                </div>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.threshold = 50;
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-banner-slider-wrapper-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-banner-slide-{{ ai_gen_id }}:not(.hidden)'));
        this.totalSlides = this.slides.length;
        
        if (this.totalSlides === 0) return;
        
        this.setupEventListeners();
        this.updateSlider();
      }

      setupEventListeners() {
        this.wrapper.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: true });
        this.wrapper.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: true });
        this.wrapper.addEventListener('touchend', () => this.handleTouchEnd());

        this.wrapper.addEventListener('mousedown', (e) => this.handleMouseDown(e));
        this.wrapper.addEventListener('mousemove', (e) => this.handleMouseMove(e));
        this.wrapper.addEventListener('mouseup', () => this.handleMouseUp());
        this.wrapper.addEventListener('mouseleave', () => this.handleMouseUp());
      }

      handleTouchStart(e) {
        this.startX = e.touches[0].clientX;
        this.isDragging = true;
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.touches[0].clientX;
      }

      handleTouchEnd() {
        if (!this.isDragging) return;
        
        const diff = this.startX - this.currentX;
        
        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
        
        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
      }

      handleMouseDown(e) {
        this.startX = e.clientX;
        this.isDragging = true;
        this.wrapper.style.cursor = 'grabbing';
      }

      handleMouseMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.clientX;
      }

      handleMouseUp() {
        if (!this.isDragging) return;
        
        const diff = this.startX - this.currentX;
        
        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
        
        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
        this.wrapper.style.cursor = 'grab';
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateSlider();
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateSlider();
      }

      updateSlider() {
        const gap = {{ block.settings.slide_gap }};
        const offset = -(this.currentSlide * 100) - (this.currentSlide * gap / this.wrapper.offsetWidth * 100);
        this.wrapper.style.transform = `translateX(${offset}%)`;
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>


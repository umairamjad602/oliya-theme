{% doc %}
  @prompt
    3 banner photos with no text or button but when click each one it redirect to soecific category and give me the option to make the desctop and mobile view the size to be small and show a small slider that shows there are more than one banner and make the backgrounf of it transparent, i want each banner to be single and swipe through them not all in one slide
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: transparent;
    position: relative;
  }

  .ai-banner-slider-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .ai-banner-slider-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    touch-action: pan-y;
  }

  .ai-banner-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    width: 100%;
    position: relative;
  }

  .ai-banner-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    cursor: pointer;
    text-decoration: none;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .ai-banner-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-banner-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-banner-dot-{{ ai_gen_id }}:hover {
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider-container-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }} class="ai-banner-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-slider-container-{{ ai_gen_id }}">
    <div class="ai-banner-slider-wrapper-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'banner_image_' | append: i
          assign url_key = 'banner_url_' | append: i
          assign banner_image = block.settings[image_key]
          assign banner_url = block.settings[url_key]
        %}

        <div class="ai-banner-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          {% if banner_url != blank %}
            <a href="{{ banner_url }}" class="ai-banner-link-{{ ai_gen_id }}">
              {% if banner_image %}
                <img
                  src="{{ banner_image | image_url: width: 2000 }}"
                  alt="{{ banner_image.alt | escape }}"
                  loading="lazy"
                  width="{{ banner_image.width }}"
                  height="{{ banner_image.height }}"
                  class="ai-banner-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-banner-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                    Add banner {{ i }} image
                  </div>
                </div>
              {% endif %}
            </a>
          {% else %}
            {% if banner_image %}
              <img
                src="{{ banner_image | image_url: width: 2000 }}"
                alt="{{ banner_image.alt | escape }}"
                loading="lazy"
                width="{{ banner_image.width }}"
                height="{{ banner_image.height }}"
                class="ai-banner-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-banner-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-banner-empty-state-{{ ai_gen_id }}">
                  Add banner {{ i }} image
                </div>
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-banner-dots-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button
          class="ai-banner-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ i }}"
        ></button>
      {% endfor %}
    </div>
  </div>
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 3;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.threshold = 50;
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-banner-slider-wrapper-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-banner-dot-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.updateSlider();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.index);
            this.goToSlide(index);
          });
        });

        this.wrapper.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: true });
        this.wrapper.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: true });
        this.wrapper.addEventListener('touchend', () => this.handleTouchEnd());

        this.wrapper.addEventListener('mousedown', (e) => this.handleMouseDown(e));
        this.wrapper.addEventListener('mousemove', (e) => this.handleMouseMove(e));
        this.wrapper.addEventListener('mouseup', () => this.handleMouseUp());
        this.wrapper.addEventListener('mouseleave', () => this.handleMouseUp());
      }

      handleTouchStart(e) {
        this.startX = e.touches[0].clientX;
        this.isDragging = true;
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.touches[0].clientX;
      }

      handleTouchEnd() {
        if (!this.isDragging) return;
        
        const diff = this.startX - this.currentX;
        
        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
        
        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
      }

      handleMouseDown(e) {
        this.startX = e.clientX;
        this.isDragging = true;
        this.wrapper.style.cursor = 'grabbing';
      }

      handleMouseMove(e) {
        if (!this.isDragging) return;
        this.currentX = e.clientX;
      }

      handleMouseUp() {
        if (!this.isDragging) return;
        
        const diff = this.startX - this.currentX;
        
        if (Math.abs(diff) > this.threshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
        
        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
        this.wrapper.style.cursor = 'grab';
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateSlider();
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateSlider();
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.wrapper.style.transform = `translateX(${offset}%)`;
        
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>


{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: transparent;
    display: block;
  }

  .ai-banner-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-banner-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease-in-out;
    gap: {{ block.settings.banner_gap }}px;
  }

  .ai-banner-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    min-width: 100%;
    position: relative;
  }

  .ai-banner-slide-{{ ai_gen_id }} a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-banner-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-banner-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-banner-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-banner-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 100%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    padding: 0 {{ block.settings.arrow_spacing }}px;
  }

  .ai-banner-arrow-{{ ai_gen_id }} {
    background: {{ block.settings.arrow_bg_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    transition: all 0.3s ease;
    opacity: {{ block.settings.arrow_opacity }};
  }

  .ai-banner-arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
    background: {{ block.settings.arrow_hover_bg_color }};
  }

  .ai-banner-arrow-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    fill: {{ block.settings.arrow_color }};
  }

  .ai-banner-arrow-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.arrow_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-banner-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-banner-arrows-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.arrow_spacing_mobile }}px;
    }

    .ai-banner-arrow-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size_mobile }}px;
      height: {{ block.settings.arrow_size_mobile }}px;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }}

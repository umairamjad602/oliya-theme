                  loading="lazy"
                  width="{{ block.settings.banner_1_mobile.width }}"
                  height="{{ block.settings.banner_1_mobile.height }}"
                >
              </div>
            {% elsif block.settings.banner_1_desktop %}
              <div class="ai-banner-mobile-{{ ai_gen_id }}">
                <img
                  src="{{ block.settings.banner_1_desktop | image_url: width: 1000 }}"
                  alt="{{ block.settings.banner_1_desktop.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.banner_1_desktop.width }}"
                  height="{{ block.settings.banner_1_desktop.height }}"

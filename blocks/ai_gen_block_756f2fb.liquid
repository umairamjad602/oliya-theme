{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-slider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-slider-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-collection-slider-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-collection-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_weight }};
    margin: 0;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-collection-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-collection-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-collection-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-slider-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.item_gap }}px)) / {{ block.settings.columns_desktop }});
    min-width: calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.item_gap }}px)) / {{ block.settings.columns_desktop }});
  }

  .ai-collection-slider-card-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    text-decoration: none;
    display: block;
  }

  .ai-collection-slider-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-collection-slider-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-slider-card-{{ ai_gen_id }}:hover .ai-collection-slider-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_hover_scale }});
  }

  .ai-collection-slider-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-collection-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-collection-slider-content-{{ ai_gen_id }} {
    margin-top: {{ block.settings.content_spacing }}px;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-collection-slider-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: {{ block.settings.name_weight }};
    margin: 0 0 {{ block.settings.name_spacing }}px;
    text-transform: {{ block.settings.name_transform }};
    letter-spacing: {{ block.settings.name_letter_spacing }}px;
  }

  .ai-collection-slider-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px {{ block.settings.button_border_style }} {{ block.settings.button_border_color }};
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
  }

  .ai-collection-slider-arrows-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.arrows_position }};
    gap: {{ block.settings.arrows_gap }}px;
    margin-top: {{ block.settings.arrows_spacing }}px;
  }

  .ai-collection-slider-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_bg_color }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    border-radius: {{ block.settings.arrow_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-collection-slider-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_bg_hover_color }};
    border-color: {{ block.settings.arrow_border_hover_color }};
  }

  .ai-collection-slider-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_icon_size }}px;
    height: {{ block.settings.arrow_icon_size }}px;
    fill: {{ block.settings.arrow_icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-collection-slider-arrow-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.arrow_icon_hover_color }};
  }

  .ai-collection-slider-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-slider-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.item_gap }}px)) / {{ block.settings.columns_mobile }});
      min-width: calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.item_gap }}px)) / {{ block.settings.columns_mobile }});
    }

    .ai-collection-slider-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-collection-slider-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_size_mobile }}px;
    }

    .ai-collection-slider-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<collection-slider-{{ ai_gen_id }} class="ai-collection-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-slider-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-collection-slider-header-{{ ai_gen_id }}">
        <h2 class="ai-collection-slider-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-collection-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-slider-track-{{ ai_gen_id }}" data-slider-track>
        {% if block.settings.collection_list != blank %}
          {% for collection in block.settings.collection_list %}
            <div class="ai-collection-slider-item-{{ ai_gen_id }}">
              <a href="{{ collection.url }}" class="ai-collection-slider-card-{{ ai_gen_id }}">
                <div class="ai-collection-slider-image-wrapper-{{ ai_gen_id }}">
                  {% if collection.featured_image %}
                    <img
                      src="{{ collection.featured_image | image_url: width: 600 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-collection-slider-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    >
                  {% else %}
                    <div class="ai-collection-slider-image-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-collection-slider-content-{{ ai_gen_id }}">
                  <h3 class="ai-collection-slider-name-{{ ai_gen_id }}">{{ collection.title }}</h3>
                  {% if block.settings.show_button %}
                    <span class="ai-collection-slider-button-{{ ai_gen_id }}">
                      {{ block.settings.button_text }}
                    </span>
                  {% endif %}
                </div>
              </a>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <div class="ai-collection-slider-item-{{ ai_gen_id }}">
              <div class="ai-collection-slider-card-{{ ai_gen_id }}">
                <div class="ai-collection-slider-image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-collection-slider-image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                </div>
                <div class="ai-collection-slider-content-{{ ai_gen_id }}">
                  <h3 class="ai-collection-slider-name-{{ ai_gen_id }}">Collection {{ i }}</h3>
                  {% if block.settings.show_button %}
                    <span class="ai-collection-slider-button-{{ ai_gen_id }}">
                      {{ block.settings.button_text }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_arrows %}
      <div class="ai-collection-slider-arrows-{{ ai_gen_id }}">
        <button class="ai-collection-slider-arrow-{{ ai_gen_id }} ai-collection-slider-prev-{{ ai_gen_id }}" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <button class="ai-collection-slider-arrow-{{ ai_gen_id }} ai-collection-slider-next-{{ ai_gen_id }}" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</collection-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        this.prevButton = this.querySelector('.ai-collection-slider-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-collection-slider-next-{{ ai_gen_id }}');
        
        if (this.prevButton && this.nextButton) {
          this.setupNavigation();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        
        this.track.addEventListener('scroll', () => this.updateButtons());
        this.updateButtons();
      }

      scroll(direction) {
        const scrollAmount = this.track.offsetWidth;
        const currentScroll = this.track.scrollLeft;
        
        if (direction === 'next') {
          this.track.scrollLeft = currentScroll + scrollAmount;
        } else {
          this.track.scrollLeft = currentScroll - scrollAmount;
        }
      }

      updateButtons() {
        const maxScroll = this.track.scrollWidth - this.track.offsetWidth;
        const currentScroll = this.track.scrollLeft;
        
        this.prevButton.disabled = currentScroll <= 0;
        this.nextButton.disabled = currentScroll >= maxScroll - 1;
      }
    }

    customElements.define('collection-slider-{{ ai_gen_id }}', CollectionSlider{{ ai_gen_id }});
  })();
</script>

